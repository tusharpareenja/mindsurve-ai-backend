APP_NAME=MindSurve API
APP_ENV=development
DEBUG=true

# Prefer postgresql+psycopg://… (plain postgresql:// is auto-normalized)
# For shared staging: use the same Neon URL as Unilever Image Study
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mindsurve

# Next.js origin(s) for CORS (comma-separated). Prefer same-origin /api/v1 proxy in the frontend.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Must match Unilever JWT_SECRET_KEY for one-login across apps
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OpenAI — conversational study brief
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure Blob Storage — chat / study uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=mindsurvey

# Participate / share link host for created studies
STUDY_SHARE_BASE_URL=https://mindsurve.com

# Creator preview URL base (studyId query param is appended)
STUDY_PREVIEW_BASE_URL=https://mindsurve.com/home/create-study/preview

# Unilever study engine (task generation / launch). Required for study generation.
# UNILEVER_API_BASE_URL=http://localhost:8000
# Optional WebSocket base; defaults to ws(s) derived from UNILEVER_API_BASE_URL
# UNILEVER_WS_BASE_URL=ws://localhost:8000
